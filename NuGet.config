<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet sources for learn-Assist.
     nuget.org serves all public dependencies.
     "github" is the GitHub Packages NuGet feed for this account/repo.
     Source mapping keeps public packages on nuget.org and routes only this
     package's ID to the GitHub feed (avoids 403s and dependency confusion). -->
<configuration>
  <config>
    <add key="fallbackPackageFolders" value="" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/Joeldev0208/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="learn-assist*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
