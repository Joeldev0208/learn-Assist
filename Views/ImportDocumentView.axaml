<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:learn_Assist.ViewModels"
        xmlns:d="http://schemas.expression.blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="340"
        x:Class="learn_Assist.Views.ImportDocumentView"
        x:DataType="vm:ImportDocumentViewModel"
        Title="Import Resource"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        MinWidth="340" MinHeight="300"
        Background="{DynamicResource WindowBackgroundBrush}">

  <StackPanel Spacing="12" Margin="24,20">
    <TextBlock Text="Import Resource" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
    <TextBlock Text="Select the type of file you want to import" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />

    <Button Command="{Binding SelectDocumentCommand}"
            HorizontalAlignment="Stretch"
            Padding="16,14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            FontSize="14"
            Foreground="{DynamicResource TextPrimaryBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <TextBlock Text="📄" FontSize="18" />
        <TextBlock Text="Document" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Button Command="{Binding SelectImageCommand}"
            HorizontalAlignment="Stretch"
            Padding="16,14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            FontSize="14"
            Foreground="{DynamicResource TextPrimaryBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <TextBlock Text="🖼" FontSize="18" />
        <TextBlock Text="Image" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Button Command="{Binding SelectVideoCommand}"
            HorizontalAlignment="Stretch"
            Padding="16,14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            FontSize="14"
            Foreground="{DynamicResource TextPrimaryBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <TextBlock Text="🎬" FontSize="18" />
        <TextBlock Text="Video" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Button Command="{Binding SelectUrlCommand}"
            HorizontalAlignment="Stretch"
            Padding="16,14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            FontSize="14"
            Foreground="{DynamicResource TextPrimaryBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <TextBlock Text="🔗" FontSize="18" />
        <TextBlock Text="URL" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- Panel de entrada de URL (se muestra tras seleccionar URL) -->
    <StackPanel Spacing="8" IsVisible="{Binding IsUrlInputVisible}">
      <TextBlock Text="URL de la p\u00e1gina web" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBox Text="{Binding NewUrl}" Watermark="https://ejemplo.com/pagina" />
      <Button Content="Importar URL" Click="ImportUrl_Click" HorizontalAlignment="Left" />
    </StackPanel>

    <TextBlock Text="{Binding ImportResult}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ImportResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,8,0,0" />
    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0" />
  </StackPanel>
</Window>
