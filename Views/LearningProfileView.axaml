<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:learn_Assist.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="640"
        x:Class="learn_Assist.Views.LearningProfileView"
        x:DataType="vm:LearningProfileViewModel"
        Icon="/Assets/learn-assist.ico"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Width="620" Height="640"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Border Background="{DynamicResource WindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Padding="32,24,32,16"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding WindowDescription}" FontSize="13"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="32,22">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding StepLabel}" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}" />

          <StackPanel Spacing="12" IsVisible="{Binding IsFirstStep}">
            <TextBlock Text="{Binding ProfileTypeLabel}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding ProfileTypeDescription}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
            <RadioButton Content="{Binding StudentRadioContent}" IsChecked="{Binding IsStudent}"
                         GroupName="ProfileType" FontSize="14" />
            <RadioButton Content="{Binding UniversityRadioContent}" IsChecked="{Binding IsUniversity}"
                         GroupName="ProfileType" FontSize="14" />
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsDetailsStep}">
            <TextBlock Text="{Binding DetailsSectionTitle}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <StackPanel Spacing="5" IsVisible="{Binding IsStudent}">
              <TextBlock Text="{Binding CourseLabel}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding Course}" PlaceholderText="{Binding CoursePlaceholder}"
                       Padding="12,9" />
              <TextBlock Text="{Binding SubjectsLabel}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding SubjectsText}"
                       PlaceholderText="{Binding SubjectsPlaceholder}"
                       Padding="12,9" />
            </StackPanel>

            <StackPanel Spacing="5" IsVisible="{Binding IsUniversity}">
              <TextBlock Text="{Binding CareerLabel}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding Career}" PlaceholderText="{Binding UniversityPlaceholder}"
                       Padding="12,9" />
              <TextBlock Text="{Binding UniversityLabel}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding University}" Padding="12,9" />
              <TextBlock Text="{Binding SemesterLabel}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding Semester}" Padding="12,9" />
                <Button Grid.Column="1" Content="{Binding ImportButtonContent}"
                        Command="{Binding SemesterImportCommand}"
                        Background="{DynamicResource ButtonSecondaryBackgroundBrush}"
                        Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"
                        CornerRadius="8" Padding="14,9" BorderThickness="0" />
              </Grid>
              <TextBlock Text="{Binding SemesterImportFeedback}"
                         FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding SemesterImportFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding SemesterLaterHint}"
                         FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding SemesterImportFeedback, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding IsPreferencesStep}">
            <TextBlock Text="{Binding PreferencesSectionTitle}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock             Text="{Binding LearningGoalQuestion}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding LearningGoal}"
                     PlaceholderText="{Binding LearningGoalPlaceholder}"
                     Padding="12,9" AcceptsReturn="True" />
            <TextBlock Text="{Binding LevelLabel}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"
                      PlaceholderText="{Binding LevelPlaceholder}" />
            <TextBlock Text="{Binding PreferredLanguageLabel}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
          </StackPanel>

          <Border Padding="12,9" CornerRadius="8"
                  Background="{DynamicResource ErrorBackgroundBrush}"
                  BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}"
                       FontSize="12" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="32,14"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="{Binding CancelButtonContent}" Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsEditing}"
                  Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                  Padding="10,7" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding BackButtonContent}" Command="{Binding BackCommand}"
                    IsVisible="{Binding IsBackVisible}"
                    Background="{DynamicResource ButtonSecondaryBackgroundBrush}"
                    Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"
                    CornerRadius="20" Padding="18,8" BorderThickness="0" />
            <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}"
                    IsEnabled="{Binding IsSaving, Converter={x:Static BoolConverters.Not}}"
                    Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                    Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                    CornerRadius="20" Padding="20,8" FontWeight="SemiBold"
                    BorderThickness="0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
