<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:learn_Assist.ViewModels"
        xmlns:services="using:learn_Assist.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="learn_Assist.Views.LoginView"
        x:DataType="vm:LoginViewModel"
        Icon="/Assets/learn-assist.ico"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Width="800" Height="500" MinWidth="640" MinHeight="420"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource InputPlaceholderBrush}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="*,*">
    <Border Background="{DynamicResource SurfaceBrush}" Grid.Column="0"
            BoxShadow="4 0 12 #0A000000">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TabControl Margin="32" MaxWidth="320" HorizontalAlignment="Center"
                  SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="{Binding TabLogin}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">

        <Button Command="{Binding ToggleThemeCommand}"
                HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                Background="Transparent" BorderThickness="0" FontSize="15"
                ToolTip.Tip="{Binding ThemeTip}"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <TextBlock Text="{Binding ThemeGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <TextBlock Text="{Binding WelcomeBack}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />
        <TextBlock Text="{Binding WelcomeSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6" />

        <Button Command="{Binding SignInWithGoogleCommand}"
                IsVisible="{Binding IsGoogleOAuthConfigured}" HorizontalAlignment="Stretch" Padding="10,9" Background="Transparent" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="20" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Assets/GoogleG_FullColor_RGB.png" Width="20" Height="20" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding SignInWithGoogle}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Grid ColumnDefinitions="*,Auto,*" Margin="0,2">
          <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Grid.Column="0" />
          <TextBlock Text="{Binding OrSeparator}" Grid.Column="1" Margin="12,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Grid.Column="2" />
        </Grid>

        <TextBlock Text="{Binding LocalAccountNote}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Center" />

        <TextBlock Text="{Binding EmailLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <DockPanel LastChildFill="True" Margin="14,0">
            <TextBlock DockPanel.Dock="Left" Text="📧" FontSize="13" VerticalAlignment="Center" />
            <TextBox Text="{Binding Email}" PlaceholderText="{Binding EmailPlaceholder}" BorderThickness="0" Padding="8,10" FontSize="13" />
          </DockPanel>
        </Border>

        <TextBlock Text="{Binding PasswordLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <DockPanel LastChildFill="True" Margin="14,0">
            <TextBlock DockPanel.Dock="Left" Text="🔒" FontSize="13" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" BorderThickness="0" Padding="8,0"
                    Command="{Binding TogglePasswordVisibilityCommand}">
              <TextBlock Text="👁" FontSize="13" VerticalAlignment="Center" />
            </Button>
            <Grid>
              <TextBox Text="{Binding Password}" PlaceholderText="{Binding PasswordPlaceholder}"
                       BorderThickness="0" Padding="8,10" FontSize="13"
                       IsVisible="{Binding IsPasswordVisible, Converter={x:Static BoolConverters.Not}}"
                       PasswordChar="*" />
              <TextBox Text="{Binding Password}" PlaceholderText="{Binding PasswordPlaceholder}"
                       BorderThickness="0" Padding="8,10" FontSize="13"
                       IsVisible="{Binding IsPasswordVisible}" />
            </Grid>
          </DockPanel>
        </Border>

        <Border CornerRadius="10" Background="{DynamicResource ErrorBackgroundBrush}" Padding="10,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Button Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" Padding="12,9" Background="{DynamicResource ButtonPrimaryBackgroundBrush}" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}" CornerRadius="20" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold">
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Content" Value="{Binding SignInButton}" />
            </Style>
            <Style Selector="Button:disabled">
              <Setter Property="Content" Value="{Binding SignInButtonLoading}" />
            </Style>
          </Button.Styles>
        </Button>

        <Button Content="{Binding CreateAccountLink}" Command="{Binding ShowRegisterCommand}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
        </TabItem>

        <TabItem Header="{Binding TabRegister}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <TextBlock Text="{Binding Register.CreateAccount}" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Register.CreateAccountSubtitle}"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

            <Button Command="{Binding Register.SignUpWithGoogleCommand}"
                    IsVisible="{Binding Register.IsGoogleOAuthConfigured}"
                    HorizontalAlignment="Stretch" Padding="10,9"
                    Background="Transparent" BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1" CornerRadius="20"
                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
              <TextBlock Text="{Binding Register.SignUpWithGoogle}" HorizontalAlignment="Center" />
            </Button>

            <TextBlock Text="{Binding Register.EmailLabel}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
              <DockPanel LastChildFill="True" Margin="14,0">
                <TextBlock DockPanel.Dock="Left" Text="📧" FontSize="13" VerticalAlignment="Center" />
                <TextBox Text="{Binding Register.Email}" PlaceholderText="{Binding Register.EmailPlaceholder}"
                         BorderThickness="0" Padding="8,10" FontSize="13" />
              </DockPanel>
            </Border>

            <TextBlock Text="{Binding Register.PasswordLabel}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
              <DockPanel LastChildFill="True" Margin="14,0">
                <TextBlock DockPanel.Dock="Left" Text="🔒" FontSize="13" VerticalAlignment="Center" />
                <Grid>
                  <TextBox Text="{Binding Register.Password}" PlaceholderText="{Binding Register.PasswordPlaceholder}"
                           BorderThickness="0" Padding="8,10" FontSize="13"
                           IsVisible="{Binding Register.IsPasswordVisible, Converter={x:Static BoolConverters.Not}}"
                           PasswordChar="*" />
                  <TextBox Text="{Binding Register.Password}" PlaceholderText="{Binding Register.PasswordPlaceholder}"
                           BorderThickness="0" Padding="8,10" FontSize="13"
                           IsVisible="{Binding Register.IsPasswordVisible}" />
                </Grid>
              </DockPanel>
            </Border>

            <TextBlock Text="{Binding Register.ConfirmPasswordLabel}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
              <DockPanel LastChildFill="True" Margin="14,0">
                <TextBlock DockPanel.Dock="Left" Text="🔒" FontSize="13" VerticalAlignment="Center" />
                <Grid>
                  <TextBox Text="{Binding Register.ConfirmPassword}" PlaceholderText="{Binding Register.ConfirmPasswordPlaceholder}"
                           BorderThickness="0" Padding="8,10" FontSize="13"
                           IsVisible="{Binding Register.IsConfirmPasswordVisible, Converter={x:Static BoolConverters.Not}}"
                           PasswordChar="*" />
                  <TextBox Text="{Binding Register.ConfirmPassword}" PlaceholderText="{Binding Register.ConfirmPasswordPlaceholder}"
                           BorderThickness="0" Padding="8,10" FontSize="13"
                           IsVisible="{Binding Register.IsConfirmPasswordVisible}" />
                </Grid>
              </DockPanel>
            </Border>

            <Border CornerRadius="10" Background="{DynamicResource ErrorBackgroundBrush}" Padding="10,8"
                    IsVisible="{Binding Register.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding Register.ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}"
                         FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Button Command="{Binding Register.RegisterCommand}" HorizontalAlignment="Stretch"
                    Padding="12,9" Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                    Foreground="{DynamicResource ButtonPrimaryForegroundBrush}" CornerRadius="20"
                    Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold">
              <TextBlock Text="{Binding Register.RegisterButton}" />
            </Button>
            <Button Content="{Binding Register.AlreadyHaveAccount}" Command="{Binding ShowLoginCommand}"
                    Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                    FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
        </TabItem>
      </TabControl>
      </ScrollViewer>
    </Border>

    <Border Background="{DynamicResource BrandPanelBrush}" Grid.Column="1">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
        <Image Source="/Assets/learn-assist-logo-light.png" Width="72" Height="72"
               HorizontalAlignment="Center"
               IsVisible="{x:Static services:ThemeService.IsLight}" />
        <Image Source="/Assets/learn-assist-logo-dark.png" Width="72" Height="72"
               HorizontalAlignment="Center"
               IsVisible="{x:Static services:ThemeService.IsDark}" />
        <TextBlock Text="Learn-Assist" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" Opacity="0.9" />
        <TextBlock Text="aprende lo que quieras" FontSize="12" Foreground="{DynamicResource BrandSubtextBrush}" HorizontalAlignment="Center" Opacity="0.7" />
      </StackPanel>
    </Border>
  </Grid>
</Window>