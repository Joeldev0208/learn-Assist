<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:learn_Assist.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="learn_Assist.Views.LoginView"
        x:DataType="vm:LoginViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="learn_Assist - Login"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Width="800" Height="500"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource InputPlaceholderBrush}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="*,*">
    <Border Background="{DynamicResource SurfaceBrush}" Grid.Column="0"
            BoxShadow="4 0 12 #0A000000">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="320" Margin="32">

        <Button Command="{Binding ToggleThemeCommand}"
                HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                Background="Transparent" BorderThickness="0" FontSize="15"
                ToolTip.Tip="Toggle light/dark theme"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <TextBlock Text="{Binding ThemeGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <TextBlock Text="Welcome back!" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />
        <TextBlock Text="learning that's everything - all in one place" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6" />

        <Button Command="{Binding SignInWithGoogleCommand}"
                IsVisible="{Binding IsGoogleOAuthConfigured}" HorizontalAlignment="Stretch" Padding="10,9" Background="Transparent" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="20" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Assets/GoogleG_FullColor_RGB.png" Width="40" Height="40" Margin="0,0,8,0"/>
            <TextBlock Text="Sign in with Google" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Content="Sign in with Apple" Command="{Binding SignInWithAppleCommand}"
                IsVisible="{Binding IsOAuthConfigured}"
                HorizontalAlignment="Stretch" Padding="10,9" Background="Transparent" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="20" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />

        <Grid ColumnDefinitions="*,Auto,*" Margin="0,2">
          <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Grid.Column="0" />
          <TextBlock Text="Or" Grid.Column="1" Margin="12,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" Grid.Column="2" />
        </Grid>

        <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <DockPanel LastChildFill="True" Margin="14,0">
            <TextBlock DockPanel.Dock="Left" Text="📧" FontSize="13" VerticalAlignment="Center" />
            <TextBox Text="{Binding Email}" PlaceholderText="Enter your email" BorderThickness="0" Padding="8,10" FontSize="13" />
          </DockPanel>
        </Border>

        <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        <Border CornerRadius="20" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <DockPanel LastChildFill="True" Margin="14,0">
            <TextBlock DockPanel.Dock="Left" Text="🔒" FontSize="13" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" BorderThickness="0" Padding="8,0"
                    Command="{Binding TogglePasswordVisibilityCommand}">
              <TextBlock Text="👁" FontSize="13" VerticalAlignment="Center" />
            </Button>
            <Grid>
              <TextBox Text="{Binding Password}" PlaceholderText="Enter your password"
                       BorderThickness="0" Padding="8,10" FontSize="13"
                       IsVisible="{Binding IsPasswordVisible, Converter={x:Static BoolConverters.Not}}"
                       PasswordChar="*" />
              <TextBox Text="{Binding Password}" PlaceholderText="Enter your password"
                       BorderThickness="0" Padding="8,10" FontSize="13"
                       IsVisible="{Binding IsPasswordVisible}" />
            </Grid>
          </DockPanel>
        </Border>

        <Border CornerRadius="10" Background="{DynamicResource ErrorBackgroundBrush}" Padding="10,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Button Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" Padding="12,9" Background="{DynamicResource ButtonPrimaryBackgroundBrush}" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}" CornerRadius="20" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold">
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Content" Value="Sign in with the email" />
            </Style>
            <Style Selector="Button:disabled">
              <Setter Property="Content" Value="Signing in..." />
            </Style>
          </Button.Styles>
        </Button>

        <Button Content="Don't have an account? Sign up" Command="{Binding GoToRegisterCommand}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource BrandPanelBrush}" Grid.Column="1">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
        <TextBlock Text="📚" FontSize="44" HorizontalAlignment="Center" />
        <TextBlock Text="Learn-Assist" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" Opacity="0.9" />
        <TextBlock Text="learn anything" FontSize="12" Foreground="{DynamicResource BrandSubtextBrush}" HorizontalAlignment="Center" Opacity="0.7" />
      </StackPanel>
    </Border>
  </Grid>
</Window>