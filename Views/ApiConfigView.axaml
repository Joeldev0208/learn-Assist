<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:learn_Assist.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"         d:DesignWidth="520" d:DesignHeight="700"
        x:Class="learn_Assist.Views.ApiConfigView"
        x:DataType="vm:ApiConfigViewModel"
        Icon="/Assets/learn-assist.ico"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Width="520" Height="700"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource InputPlaceholderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource SurfaceBrush}" Padding="32">
    <ScrollViewer>
    <StackPanel Spacing="14" VerticalAlignment="Center">
      <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding IntroText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />

      <TextBlock Text="{Binding ProviderLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox ItemsSource="{Binding ProviderNames}"
                SelectedItem="{Binding SelectedProvider}"
                Padding="10,8" FontSize="13" CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />

      <TextBlock Text="{Binding BaseUrlLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                 IsVisible="{Binding IsOpenCode, Converter={x:Static BoolConverters.Not}}" />
      <Border CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
        <TextBox Text="{Binding BaseUrl}" PlaceholderText="{Binding BaseUrlPlaceholder}"
                 BorderThickness="0" Padding="10,8" FontSize="13"
                 IsVisible="{Binding IsOpenCode, Converter={x:Static BoolConverters.Not}}" />
      </Border>
      <TextBlock Text="{Binding OpenCodeInfo}"
                 FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding IsOpenCode}" />

      <TextBlock Text="{Binding ApiKeyLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                 IsVisible="{Binding IsOpenCode, Converter={x:Static BoolConverters.Not}}" />
      <Border CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
        <TextBox Text="{Binding ApiKey}" PlaceholderText="{Binding ApiKeyPlaceholder}"
                 BorderThickness="0" Padding="10,8" FontSize="13" PasswordChar="*"
                 IsVisible="{Binding IsOpenCode, Converter={x:Static BoolConverters.Not}}" />
      </Border>

      <TextBlock Text="{Binding OpenCodeModelLabel}" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 IsVisible="{Binding IsOpenCode}" />
      <ComboBox ItemsSource="{Binding OpenCodeModels}"
                SelectedItem="{Binding Model}"
                IsVisible="{Binding IsOpenCode}"
                Padding="10,8" FontSize="13"
                CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />

      <TextBlock Text="{Binding ModelLabel}" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 IsVisible="{Binding IsOpenCode, Converter={x:Static BoolConverters.Not}}" />
      <Border CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
              Background="{DynamicResource InputBackgroundBrush}"
              IsVisible="{Binding IsOpenCode, Converter={x:Static BoolConverters.Not}}">
        <TextBox Text="{Binding Model}" PlaceholderText="{Binding ModelPlaceholder}"
                 BorderThickness="0" Padding="10,8" FontSize="13" />
      </Border>

      <StackPanel Spacing="8" IsVisible="{Binding IsOpenCode}">
        <TextBlock Text="{Binding OpenCodeExecutableLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <TextBox Text="{Binding OpenCodeExecutablePath}" PlaceholderText="{Binding OpenCodeExecutablePlaceholder}" BorderThickness="0" Padding="10,8" FontSize="13" />
        </Border>
        <TextBlock Text="{Binding OpenCodeWorkspaceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <TextBox Text="{Binding OpenCodeWorkspaceDirectory}" PlaceholderText="{Binding OpenCodeWorkspacePlaceholder}" BorderThickness="0" Padding="10,8" FontSize="13" />
        </Border>
      </StackPanel>

      <TextBlock Text="{Binding SessionsDirectoryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="{Binding BrowseButtonContent}" Margin="6,0,0,0"
                Command="{Binding BrowseSessionsDirectoryCommand}"
                Padding="12,7" FontSize="12" CornerRadius="6"
                Background="{DynamicResource ButtonSecondaryBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                Foreground="{DynamicResource ButtonSecondaryForegroundBrush}" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}">
          <TextBox Text="{Binding SessionsDirectory}" PlaceholderText="{Binding SessionsDirectoryPlaceholder}"
                   BorderThickness="0" Padding="10,8" FontSize="13" />
        </Border>
      </DockPanel>

      <Border CornerRadius="8" Background="{DynamicResource ErrorBackgroundBrush}" Padding="10,8"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" />
      </Border>

      <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
        <Button Grid.Column="0" Command="{Binding SkipCommand}"
                Padding="12,9" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                CornerRadius="20" FontSize="13"
                Content="{Binding SkipButtonContent}" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
        <Button Grid.Column="1" Command="{Binding SaveCommand}"
                Padding="12,9" Background="{DynamicResource ButtonPrimaryBackgroundBrush}" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                CornerRadius="20" FontSize="13" FontWeight="SemiBold"
                Content="{Binding SaveButtonContent}" HorizontalAlignment="Stretch" Margin="6,0,0,0" />
      </Grid>
    </StackPanel>
    </ScrollViewer>
  </Border>
</Window>