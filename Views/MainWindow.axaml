<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:learn_Assist.ViewModels"
        xmlns:models="using:learn_Assist.Models"
        xmlns:conv="using:learn_Assist.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="learn_Assist.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="learn_Assist"
        WindowStartupLocation="CenterScreen"
        Width="1200" Height="700" MinWidth="720" MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Resources>
    <conv:MessageRoleToAlignmentConverter x:Key="RoleToAlignment" />
    <conv:MessageRoleToBubbleColorConverter x:Key="RoleToBubble" />
    <conv:ContentTypeToEmojiConverter x:Key="TypeToEmoji" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- ===== Update banner ===== -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1"
            Padding="14,10" IsVisible="{Binding IsUpdateAvailable}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Width="30" Height="30"
                  Command="{Binding EndLearningSessionCommand}"
                  IsVisible="{Binding IsLearningSessionActive}"
                  Background="Transparent" BorderThickness="0" Padding="0"
                  Foreground="{DynamicResource TextMutedBrush}"
                  ToolTip.Tip="Return to learning home">
            <TextBlock Text="←" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Command="{Binding ApplyUpdateCommand}"
                  IsEnabled="{Binding IsUpdating, Converter={x:Static BoolConverters.Not}}"
                  Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                  Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                  CornerRadius="16" Padding="14,6" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
            <TextBlock Text="{Binding UpdateButtonText}" />
          </Button>
          <Button Command="{Binding DismissUpdateCommand}" Width="26" Height="26" Padding="0"
                  Background="Transparent" BorderThickness="0" FontSize="13"
                  Foreground="{DynamicResource TextMutedBrush}">
            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding UpdateMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UpdateError}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding UpdateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Main Content ===== -->
    <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnDefinitions="260,1,*,1,220">
      <Border Background="{DynamicResource SidebarBrush}" Grid.Column="0"
              IsVisible="{Binding IsSessionsVisible}">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Padding="16,16,16,8">
            <StackPanel Spacing="8">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Width="30" Height="30"
                        Command="{Binding SessionList.NewSessionCommand}"
                        Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                        Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                        CornerRadius="15" BorderThickness="0" Padding="0"
                        ToolTip.Tip="Start a new chat">
                  <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <StackPanel>
                  <TextBlock Text="Your workspace" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  <TextBlock Text="Chat history" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </DockPanel>
              <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,2,0,0" />
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding SessionList.CurrentUserEmail}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
          </Border>

          <ScrollViewer Padding="8,0">
            <ListBox ItemsSource="{Binding SessionList.Sessions}"
                     SelectedItem="{Binding SessionList.ActiveSession}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:ChatSession">
                  <Border Padding="12,10" Margin="0,2" CornerRadius="8" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Background="{DynamicResource BorderBrush}" Grid.Column="1" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto,Auto">
        <Border Padding="14,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource HeaderBackgroundBrush}">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Width="30" Height="30"
                      Command="{Binding ToggleSessionsCommand}"
                      IsVisible="{Binding IsCompactLayout}"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      Foreground="{DynamicResource TextMutedBrush}"
                      ToolTip.Tip="Show chat history">
                <TextBlock Text="☰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Width="30" Height="30"
                      Command="{Binding ToggleResourcesCommand}"
                      IsVisible="{Binding IsCompactLayout}"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      Foreground="{DynamicResource TextMutedBrush}"
                      ToolTip.Tip="Show resources">
                <TextBlock Text="▣" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Width="30" Height="30"
                      Command="{Binding ToggleThemeCommand}"
                      Background="Transparent" BorderThickness="0"
                      FontSize="15" Padding="0"
                      ToolTip.Tip="Toggle light/dark theme"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ThemeGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Width="30" Height="30"
                      Command="{Binding ReconfigureAiCommand}"
                      Background="Transparent" BorderThickness="0"
                      FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Padding="0"
                      ToolTip.Tip="Configure AI provider"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚙" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Learn-Assist" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="5"
                          IsVisible="{Binding IsLearningSessionActive}">
                <TextBlock Text="Learning workspace ·" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding LearningGoal}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBlock Text="One clear step at a time"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding IsLearningSessionActive, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="28,24" Background="{DynamicResource WindowBackgroundBrush}"
                      IsVisible="{Binding IsLearningSessionActive, Converter={x:Static BoolConverters.Not}}">
          <StackPanel MaxWidth="700" HorizontalAlignment="Center" Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock Text="Continue learning" FontSize="28" FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Choose one goal. Learn it, practice it, and leave with a clear next step."
                         FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="22" CornerRadius="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="16">
                <StackPanel Spacing="5">
                  <TextBlock Text="What do you want to understand?"
                             FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Keep it specific. The app will guide you through one focused session."
                             FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Text="{Binding LearningGoal}"
                         PlaceholderText="For example: React component state"
                         FontSize="15" Padding="14,11" CornerRadius="10"
                         Background="{DynamicResource InputBackgroundBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Command="{Binding StartLearningSessionCommand}"
                        Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                        Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                        CornerRadius="10" Padding="18,11"
                        HorizontalAlignment="Left" BorderThickness="0">
                  <TextBlock Text="Start learning session" FontSize="14" FontWeight="SemiBold" />
                </Button>
              </StackPanel>
            </Border>

            <Button Command="{Binding StartQuickSessionCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource BrandBrush}"
                    HorizontalAlignment="Center" Padding="10,6">
              <TextBlock Text="Start a quick 5-minute session" FontSize="13" />
            </Button>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Padding="14" CornerRadius="12"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="1  Understand" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="A short explanation without the noise."
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="14" CornerRadius="12"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="2  Practice" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="A small task that makes it stick."
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Padding="14" CornerRadius="12"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="3  Explain" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Say it back and know what comes next."
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" Padding="24,16" x:Name="MessagesScroll"
                      Background="{DynamicResource WindowBackgroundBrush}"
                      IsVisible="{Binding IsLearningSessionActive}">
          <StackPanel Spacing="14">
            <Border MaxWidth="720" HorizontalAlignment="Center" Padding="14,12"
                    CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding LearningStepLabel}" FontSize="11"
                             Foreground="{DynamicResource BrandBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding LearningProgressText}" FontSize="14"
                             Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding NeedLearningHelpCommand}"
                        Background="{DynamicResource ButtonSecondaryBackgroundBrush}"
                        Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="10,7">
                  <TextBlock Text="Make it simpler" FontSize="12" />
                </Button>
                <Button Grid.Column="2" Command="{Binding CompleteLearningStepCommand}"
                        Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                        Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                        BorderThickness="0" CornerRadius="8" Padding="10,7">
                  <TextBlock Text="{Binding LearningActionText}" FontSize="12" />
                </Button>
              </Grid>
            </Border>
            <Border MaxWidth="720" HorizontalAlignment="Center" Padding="14,12"
                    CornerRadius="12" Background="{DynamicResource SuccessTextBrush}"
                    IsVisible="{Binding IsLearningSessionComplete}">
              <TextBlock Text="Nice work. You completed this focused session. Return when you are ready for the next idea."
                         Foreground="{DynamicResource BrandTextBrush}" TextWrapping="Wrap" FontSize="13" />
            </Border>
            <ItemsControl ItemsSource="{Binding Chat.Messages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:ChatMessage">
                  <Grid HorizontalAlignment="Stretch" Margin="0,0,0,10">
                    <Border MaxWidth="720"
                            HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignment}}"
                            Padding="14,12" CornerRadius="12"
                            Background="{Binding Role, Converter={StaticResource RoleToBubble}}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <TextBlock Text="{Binding Content}" FontSize="14"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" LineHeight="22" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,8" Background="{DynamicResource ErrorBackgroundBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="0,1,0,0"
                IsVisible="{Binding Chat.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding Chat.ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="3" Padding="20,8"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                IsVisible="{Binding Chat.IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressBar Width="72" Height="5" IsIndeterminate="True"
                         Foreground="{DynamicResource BrandBrush}"
                         Background="{DynamicResource InputBorderBrush}" />
            <TextBlock Text="Thinking..." FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="20,14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                IsVisible="{Binding IsLearningSessionActive}">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Width="38" Height="38" Margin="10,0,0,0"
                    Command="{Binding Chat.SendMessageCommand}"
                    IsEnabled="{Binding Chat.IsLoading, Converter={x:Static BoolConverters.Not}}"
                    Background="{DynamicResource ButtonPrimaryBackgroundBrush}" CornerRadius="19" BorderThickness="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
              <TextBlock Text="→" FontSize="18" Foreground="{DynamicResource ButtonPrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <TextBox Text="{Binding Chat.MessageText}"
                     PlaceholderText="What's up with the learning?"
                     FontSize="14" Padding="14,9" CornerRadius="22"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="42" MaxHeight="120"
                     BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     IsEnabled="{Binding Chat.IsLoading, Converter={x:Static BoolConverters.Not}}"
                     KeyDown="OnMessageTextBoxKeyDown" />
          </DockPanel>
        </Border>
      </Grid>

      <Border Background="{DynamicResource BorderBrush}" Grid.Column="3" />

      <Border Background="{DynamicResource SidebarBrush}" Grid.Column="4"
              IsVisible="{Binding IsResourcesVisible}">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Padding="14,16,14,8">
            <StackPanel Spacing="6">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Width="28" Height="28"
                        Command="{Binding DocumentList.ShowImportDialogCommand}"
                        Background="{DynamicResource ButtonSecondaryBackgroundBrush}" CornerRadius="14" BorderThickness="0"
                        FontSize="16" Foreground="{DynamicResource ButtonSecondaryForegroundBrush}" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <TextBlock Text="Resources" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,2,0,0" />
            </StackPanel>
          </Border>

          <ScrollViewer Padding="8,0">
            <ListBox ItemsSource="{Binding DocumentList.Documents}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:UserDocument">
                  <Border Padding="8,6" Margin="0,1" CornerRadius="6">
                    <DockPanel LastChildFill="True">
                      <TextBlock DockPanel.Dock="Left" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Text="{Binding ContentType, Converter={StaticResource TypeToEmoji}}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                  <Setter Property="CornerRadius" Value="6" />
                </Style>
              </ListBox.Styles>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== Tutorial Overlay ===== -->
    <Border IsVisible="{Binding Tutorial.IsVisible}"
            Background="{DynamicResource OverlayBrush}"
            ZIndex="10">
      <Border Background="{DynamicResource SurfaceBrush}"
              CornerRadius="16"
              MaxWidth="440"
              MaxHeight="400"
              Padding="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="0 8 24 #26000000">
        <StackPanel Spacing="20">
          <!-- Dots indicator -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <ItemsControl ItemsSource="{Binding Tutorial.Steps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:Object">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource InputBorderBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Step content -->
          <TextBlock Text="{Binding Tutorial.StepTitle}"
                     FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <TextBlock Text="{Binding Tutorial.StepDescription}"
                     FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     LineHeight="22" />

          <!-- Buttons -->
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0"
                    Command="{Binding Tutorial.SkipCommand}"
                    Background="Transparent"
                    Foreground="{DynamicResource TextMutedBrush}"
                    FontSize="13"
                    Content="Skip"
                    Padding="8,6" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding Tutorial.BackCommand}"
                      Background="{DynamicResource ButtonSecondaryBackgroundBrush}"
                      Foreground="{DynamicResource ButtonSecondaryForegroundBrush}"
                      CornerRadius="20"
                      Padding="16,8"
                      FontSize="13"
                      BorderThickness="0"
                      IsVisible="{Binding Tutorial.IsFirstStep, Converter={x:Static BoolConverters.Not}}">
                <TextBlock Text="Back" />
              </Button>

              <Button Command="{Binding Tutorial.NextCommand}"
                      Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                      Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                      CornerRadius="20"
                      Padding="20,8"
                      FontSize="13"
                      BorderThickness="0">
                <TextBlock Text="{Binding Tutorial.NextButtonText}" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>