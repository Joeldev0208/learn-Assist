{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    "uiinspect": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "UIInspect.MCP.Server@0.*",
        "--prerelease",
        "--yes"
      ]
    }
  }
}
